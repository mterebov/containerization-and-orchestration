{
  "uid": "lab3-shop",
  "title": "Lab 3: shop",
  "tags": [
    "lab3",
    "shop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "api: запросов в секунду по коду",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(http_requests_total{namespace=\"shop\", job=\"api\"}[2m]))",
          "legendFormat": "{{code}}"
        }
      ],
      "description": "RED: rate. Все HTTP-запросы к api, включая пробы kubelet."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "api: доля 5xx (алерт ApiHighErrorRate > 5%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{namespace=\"shop\", job=\"api\", code=~\"5..\"}[2m])) / sum(rate(http_requests_total{namespace=\"shop\", job=\"api\"}[2m]))",
          "legendFormat": "5xx share"
        }
      ],
      "description": "RED: errors."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "api: p95 времени ответа",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"shop\", job=\"api\"}[2m])))",
          "legendFormat": "p95"
        }
      ],
      "description": "RED: duration."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "заказы: создано и обработано за 5 минут (алерт OrdersNotProcessed)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(orders_created_total{namespace=\"shop\"}[5m]))",
          "legendFormat": "created"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(worker_orders_processed_total{namespace=\"shop\"}[5m])) or vector(0)",
          "legendFormat": "processed"
        }
      ],
      "description": "Бизнес-метрика: если created растёт, а processed нет, worker не работает."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "db_up по подам (1 = база доступна)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "db_up{namespace=\"shop\"}",
          "legendFormat": "{{job}}/{{pod}}"
        }
      ],
      "description": "Каждый под api и worker сам пингует postgres раз в 5 секунд."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "api: реплики desired / available / unavailable (алерт ApiReplicasUnavailable)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_deployment_spec_replicas{namespace=\"shop\", deployment=\"api\"}",
          "legendFormat": "desired"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_deployment_status_replicas_available{namespace=\"shop\", deployment=\"api\"}",
          "legendFormat": "available"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_deployment_status_replicas_unavailable{namespace=\"shop\", deployment=\"api\"}",
          "legendFormat": "unavailable"
        }
      ],
      "description": "Из kube-state-metrics. unavailable > 0 дольше 3 минут = застрявшая раскатка."
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
